{
  "name": "expermit-eln",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "electron .",
    "desktop:selftest": "electron . --selftest",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "1.61.0",
    "nanoid": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.fengtong.expermit",
    "productName": "ExPermit 实验记录本",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "node_modules/fflate/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "www"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "artifactName": "ExPermit-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "ExPermit-Portable-${version}.exe"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "ExPermit-${version}-${arch}.${ext}"
    }
  }
}
